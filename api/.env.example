# ===================================================================
# DMS API - Environment Configuration
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# ===================================================================

NODE_ENV=development
PORT=3000

# -------------------------------------------------------------------
# Database (PostgreSQL)
# -------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/dms?schema=public"

# -------------------------------------------------------------------
# JWT Secrets (use `openssl rand -base64 64` to generate strong values)
# -------------------------------------------------------------------
JWT_ACCESS_SECRET=replace_with_a_long_random_access_secret
JWT_ACCESS_EXPIRES_IN=15m

JWT_REFRESH_SECRET=replace_with_a_long_random_refresh_secret
JWT_REFRESH_EXPIRES_IN=7d

# -------------------------------------------------------------------
# CORS - the origin of the frontend application
# -------------------------------------------------------------------
FRONTEND_URL=http://localhost:5173

# -------------------------------------------------------------------
# Security / Brute-force protection
# -------------------------------------------------------------------
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15

# Argon2 password hashing parameters (adjust to server hardware)
ARGON2_MEMORY_KB=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=4

# -------------------------------------------------------------------
# Tokens
# -------------------------------------------------------------------
EMAIL_VERIFICATION_TOKEN_TTL_MINUTES=1440
PASSWORD_RESET_TOKEN_TTL_MINUTES=15

# -------------------------------------------------------------------
# Rate limiting
# -------------------------------------------------------------------
# Global throttling (requests per ttl window)
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=100
# Stricter limit for authentication endpoints (login/register/etc.)
AUTH_THROTTLE_TTL_SECONDS=60
AUTH_THROTTLE_LIMIT=5

# -------------------------------------------------------------------
# Development only: when true, email verification and password reset
# tokens are returned in the API response so they can be used without
# a real mail server. MUST be false in production.
# -------------------------------------------------------------------
DEV_RETURN_TOKENS=true

# -------------------------------------------------------------------
# Cookie settings
# -------------------------------------------------------------------
# sameSite: 'lax' | 'strict' | 'none'
COOKIE_SAMESITE=lax
# Refresh token cookie max age in milliseconds (defaults to JWT_REFRESH_EXPIRES_IN)
COOKIE_PATH=/api/auth
