NODE_ENV=test
PORT=3100

DATABASE_URL="postgresql://postgres:123@localhost:5432/dms_test?schema=public"

JWT_ACCESS_SECRET=test_access_secret_that_is_long_enough_123456
JWT_ACCESS_EXPIRES_IN=15m

JWT_REFRESH_SECRET=test_refresh_secret_that_is_long_enough_123456
JWT_REFRESH_EXPIRES_IN=7d

FRONTEND_URL=http://localhost:5173

MAX_LOGIN_ATTEMPTS=3
LOCKOUT_DURATION_MINUTES=15

ARGON2_MEMORY_KB=16384
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=4

EMAIL_VERIFICATION_TOKEN_TTL_MINUTES=1440
PASSWORD_RESET_TOKEN_TTL_MINUTES=15

THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=1000
AUTH_THROTTLE_TTL_SECONDS=60
AUTH_THROTTLE_LIMIT=1000

DEV_RETURN_TOKENS=true

COOKIE_SAMESITE=lax
COOKIE_PATH=/api/auth
